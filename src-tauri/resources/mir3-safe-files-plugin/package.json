{
  "name": "@mir3-studio/dsh-mir3-safe-files",
  "type": "module",
  "version": "0.1.1",
  "description": "Optional format-preserving Draft editors for MIR3 TXT, Lua and BIFF XLS files",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shenmuli0324-glitch/mir3-studio-ai.git",
    "directory": "src-tauri/resources/mir3-safe-files-plugin"
  },
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "files": ["CHANGELOG.md", "README.md", "cordis.patch.yml", "lib"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-runtime", "dsh-better-sidebar"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-sandbox-policy": "*",
    "@deepseek-ai/dsh-session": "*",
    "dsh-better-sidebar": ">=0.15.2",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "@deepseek-ai/dsh-sandbox-policy": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "dsh-better-sidebar": { "optional": true },
    "react": { "optional": true }
  }
}
