{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mir3://domain/first_charge/resource.schema.json",
  "title": "first_charge.first-charge-record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tierId": {
      "type": "string",
      "minLength": 1
    },
    "chargeThreshold": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100000000
    },
    "rewardItemId": {
      "type": "string",
      "minLength": 1,
      "x-mir3-reference-system": "item"
    },
    "rewardCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999
    },
    "minimumVipLevel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99
    }
  },
  "required": [
    "tierId",
    "chargeThreshold",
    "rewardItemId",
    "rewardCount",
    "minimumVipLevel"
  ],
  "x-mir3": {
    "uniqueKey": [
      "tierId"
    ],
    "clientEngineConsistency": {
      "matchBy": "tierId",
      "compareFields": [
        "tierId",
        "chargeThreshold"
      ]
    },
    "runtimeRule": "first-charge.first-tier-is-minimum"
  }
}
