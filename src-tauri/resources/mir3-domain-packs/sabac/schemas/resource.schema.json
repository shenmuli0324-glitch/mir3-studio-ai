{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mir3://domain/sabac/resource.schema.json",
  "title": "sabac.sabac-phase-record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "phaseId": {
      "type": "string",
      "minLength": 1
    },
    "battleMapId": {
      "type": "string",
      "minLength": 1,
      "x-mir3-reference-system": "map"
    },
    "startMinute": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10079
    },
    "endMinute": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10080
    },
    "guildRewardItemId": {
      "type": "string",
      "minLength": 1,
      "x-mir3-reference-system": "item"
    }
  },
  "required": [
    "phaseId",
    "battleMapId",
    "startMinute",
    "endMinute",
    "guildRewardItemId"
  ],
  "x-mir3": {
    "uniqueKey": [
      "phaseId"
    ],
    "clientEngineConsistency": {
      "matchBy": "phaseId",
      "compareFields": [
        "phaseId",
        "battleMapId"
      ]
    },
    "runtimeRule": "sabac.phases-ordered-and-regions-contained"
  }
}
