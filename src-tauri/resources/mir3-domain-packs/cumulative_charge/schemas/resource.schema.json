{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mir3://domain/cumulative_charge/resource.schema.json",
  "title": "cumulative_charge.cumulative-charge-record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tierId": {
      "type": "string",
      "minLength": 1
    },
    "cycleId": {
      "type": "string",
      "minLength": 1
    },
    "chargeThreshold": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100000000
    },
    "rewardItemId": {
      "type": "string",
      "minLength": 1,
      "x-mir3-reference-system": "item"
    },
    "rewardCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999
    }
  },
  "required": [
    "tierId",
    "cycleId",
    "chargeThreshold",
    "rewardItemId",
    "rewardCount"
  ],
  "x-mir3": {
    "uniqueKey": [
      "cycleId",
      "chargeThreshold"
    ],
    "clientEngineConsistency": {
      "matchBy": "tierId",
      "compareFields": [
        "cycleId",
        "chargeThreshold"
      ]
    },
    "runtimeRule": "cumulative-charge.thresholds-strictly-increase"
  }
}
