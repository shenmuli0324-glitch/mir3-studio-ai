{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mir3://domain/cross_server/resource.schema.json",
  "title": "cross_server.cross-server-route-record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "routeId": {
      "type": "string",
      "minLength": 1
    },
    "sourceShard": {
      "type": "string",
      "minLength": 1
    },
    "targetShard": {
      "type": "string",
      "minLength": 1
    },
    "minimumEngineVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\d+\\.\\d+$"
    },
    "maximumEngineVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\d+\\.\\d+$"
    },
    "maximumConcurrentPlayers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "seasonId": {
      "type": "string",
      "minLength": 1,
      "x-mir3-reference-system": "season"
    }
  },
  "required": [
    "routeId",
    "sourceShard",
    "targetShard",
    "minimumEngineVersion",
    "maximumEngineVersion",
    "maximumConcurrentPlayers",
    "seasonId"
  ],
  "x-mir3": {
    "uniqueKey": [
      "routeId"
    ],
    "clientEngineConsistency": {
      "matchBy": "routeId",
      "compareFields": [
        "routeId",
        "sourceShard",
        "targetShard"
      ]
    },
    "runtimeRule": "cross-server.route-and-engine-range-compatible"
  }
}
