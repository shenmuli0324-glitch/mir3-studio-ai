{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mir3://domain/skill/resource.schema.json",
  "title": "skill.skill-record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "skillId": {
      "type": "string",
      "minLength": 1
    },
    "skillLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "manaCost": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "cooldownMilliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000
    },
    "appliedBuffId": {
      "type": "string",
      "minLength": 1,
      "x-mir3-reference-system": "buff"
    }
  },
  "required": [
    "skillId",
    "skillLevel",
    "manaCost",
    "cooldownMilliseconds",
    "appliedBuffId"
  ],
  "x-mir3": {
    "uniqueKey": [
      "skillId",
      "skillLevel"
    ],
    "clientEngineConsistency": {
      "matchBy": "skillId",
      "compareFields": [
        "skillId",
        "skillLevel"
      ]
    },
    "runtimeRule": "skill.level-curve-contiguous"
  }
}
