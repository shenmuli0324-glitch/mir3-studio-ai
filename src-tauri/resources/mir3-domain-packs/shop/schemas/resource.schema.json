{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mir3://domain/shop/resource.schema.json",
  "title": "shop.shop-offer-record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "offerId": {
      "type": "string",
      "minLength": 1
    },
    "shopId": {
      "type": "string",
      "minLength": 1
    },
    "itemId": {
      "type": "string",
      "minLength": 1,
      "x-mir3-reference-system": "item"
    },
    "currencyItemId": {
      "type": "string",
      "minLength": 1,
      "x-mir3-reference-system": "item"
    },
    "price": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000
    },
    "startEpochSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "endEpochSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4102444800
    }
  },
  "required": [
    "offerId",
    "shopId",
    "itemId",
    "currencyItemId",
    "price",
    "startEpochSeconds",
    "endEpochSeconds"
  ],
  "x-mir3": {
    "uniqueKey": [
      "offerId"
    ],
    "clientEngineConsistency": {
      "matchBy": "offerId",
      "compareFields": [
        "offerId",
        "shopId"
      ]
    },
    "runtimeRule": "shop.sale-window-and-price-valid"
  }
}
