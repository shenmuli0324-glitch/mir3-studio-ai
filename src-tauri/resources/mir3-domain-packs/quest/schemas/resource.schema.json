{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mir3://domain/quest/resource.schema.json",
  "title": "quest.quest-record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "questId": {
      "type": "string",
      "minLength": 1
    },
    "startNpcId": {
      "type": "string",
      "minLength": 1,
      "x-mir3-reference-system": "npc"
    },
    "targetMonsterId": {
      "type": "string",
      "minLength": 1,
      "x-mir3-reference-system": "monster"
    },
    "rewardItemId": {
      "type": "string",
      "minLength": 1,
      "x-mir3-reference-system": "item"
    },
    "minimumLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "nextQuestId": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "questId",
    "startNpcId",
    "targetMonsterId",
    "rewardItemId",
    "minimumLevel",
    "nextQuestId"
  ],
  "x-mir3": {
    "uniqueKey": [
      "questId"
    ],
    "clientEngineConsistency": {
      "matchBy": "questId",
      "compareFields": [
        "questId",
        "nextQuestId"
      ]
    },
    "runtimeRule": "quest.chain-acyclic-and-reachable"
  }
}
