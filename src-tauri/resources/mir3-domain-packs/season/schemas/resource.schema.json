{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mir3://domain/season/resource.schema.json",
  "title": "season.season-record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "seasonId": {
      "type": "string",
      "minLength": 1
    },
    "startEpochSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "endEpochSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4102444800
    },
    "rankingBoardId": {
      "type": "string",
      "minLength": 1,
      "x-mir3-reference-system": "ranking"
    },
    "seasonShopId": {
      "type": "string",
      "minLength": 1,
      "x-mir3-reference-system": "shop"
    }
  },
  "required": [
    "seasonId",
    "startEpochSeconds",
    "endEpochSeconds",
    "rankingBoardId",
    "seasonShopId"
  ],
  "x-mir3": {
    "uniqueKey": [
      "seasonId"
    ],
    "clientEngineConsistency": {
      "matchBy": "seasonId",
      "compareFields": [
        "seasonId",
        "startEpochSeconds"
      ]
    },
    "runtimeRule": "season.window-and-settlement-ordered"
  }
}
