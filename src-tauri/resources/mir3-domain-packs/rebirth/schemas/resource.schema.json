{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mir3://domain/rebirth/resource.schema.json",
  "title": "rebirth.rebirth-record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rebirthTier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99
    },
    "minimumLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "costItemId": {
      "type": "string",
      "minLength": 1,
      "x-mir3-reference-system": "item"
    },
    "costAmount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "grantedTitleId": {
      "type": "string",
      "minLength": 1,
      "x-mir3-reference-system": "title"
    }
  },
  "required": [
    "rebirthTier",
    "minimumLevel",
    "costItemId",
    "costAmount",
    "grantedTitleId"
  ],
  "x-mir3": {
    "uniqueKey": [
      "rebirthTier"
    ],
    "clientEngineConsistency": {
      "matchBy": "rebirthTier",
      "compareFields": [
        "rebirthTier",
        "minimumLevel"
      ]
    },
    "runtimeRule": "rebirth.minimum-level-reachable"
  }
}
