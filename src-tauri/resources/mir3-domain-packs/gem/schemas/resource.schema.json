{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mir3://domain/gem/resource.schema.json",
  "title": "gem.gem-record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "gemId": {
      "type": "string",
      "minLength": 1
    },
    "gemTier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "socketType": {
      "type": "string",
      "enum": [
        "attack",
        "defense",
        "utility",
        "universal"
      ]
    },
    "itemId": {
      "type": "string",
      "minLength": 1,
      "x-mir3-reference-system": "item"
    },
    "grantedBuffId": {
      "type": "string",
      "minLength": 1,
      "x-mir3-reference-system": "buff"
    }
  },
  "required": [
    "gemId",
    "gemTier",
    "socketType",
    "itemId",
    "grantedBuffId"
  ],
  "x-mir3": {
    "uniqueKey": [
      "gemId",
      "gemTier"
    ],
    "clientEngineConsistency": {
      "matchBy": "gemId",
      "compareFields": [
        "gemId",
        "gemTier"
      ]
    },
    "runtimeRule": "gem.tier-chain-contiguous"
  }
}
