{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mir3://domain/resource_production/resource.schema.json",
  "title": "resource_production.production-point-record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "pointId": {
      "type": "string",
      "minLength": 1
    },
    "mapId": {
      "type": "string",
      "minLength": 1,
      "x-mir3-reference-system": "map"
    },
    "outputItemId": {
      "type": "string",
      "minLength": 1,
      "x-mir3-reference-system": "item"
    },
    "intervalSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31536000
    },
    "yieldCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999
    },
    "guardMonsterId": {
      "type": "string",
      "minLength": 1,
      "x-mir3-reference-system": "monster"
    }
  },
  "required": [
    "pointId",
    "mapId",
    "outputItemId",
    "intervalSeconds",
    "yieldCount",
    "guardMonsterId"
  ],
  "x-mir3": {
    "uniqueKey": [
      "pointId"
    ],
    "clientEngineConsistency": {
      "matchBy": "pointId",
      "compareFields": [
        "pointId",
        "mapId"
      ]
    },
    "runtimeRule": "production.point-inside-map-and-rate-positive"
  }
}
