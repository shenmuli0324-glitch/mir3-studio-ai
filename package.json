{
  "name": "mir3-studio-ai",
  "type": "module",
  "version": "0.9.15",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "description": "AI development workspace for MIR3 engine projects.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "release": "pnpm version:bump -- patch",
    "test": "vitest",
    "lint": "eslint",
    "knip": "knip",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "brand:audit": "node scripts/brand-audit.mjs",
    "plugin:audit": "node scripts/audit-harness-plugins.mjs",
    "domain:audit": "node scripts/audit-domain-kernel.mjs",
    "domain:corpus:audit": "node scripts/audit-domain-corpus.mjs",
    "domain:corpus:accept": "node scripts/run-domain-corpus-acceptance.mjs",
    "version:bump": "node scripts/bump-product-version.mjs",
    "version:check": "node scripts/check-product-version.mjs",
    "release:check": "pnpm version:check && pnpm brand:audit && pnpm plugin:audit && pnpm domain:audit",
    "package:mac": "node scripts/package-macos.mjs",
    "smoke:mac": "node scripts/smoke-macos-package.mjs",
    "sidecar:dev": "node scripts/prepare-mir3-sidecar.mjs debug",
    "sidecar:build": "node scripts/prepare-mir3-sidecar.mjs release",
    "baseline:build": "node scripts/prepare-runtime-baseline.mjs",
    "icons": "tauri icon public/brand/mir3-studio-ai.svg --output src-tauri/icons/mir3-studio-ai"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@gravity-ui/icons": "^2.21.0",
    "@hairy/react-lib": "^1.52.0",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@overlastic/react": "^0.9.0",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.11.1",
    "@uiw/react-codemirror": "^4.25.11",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-if-lite": "^0.1.0",
    "react-use": "^17.6.1",
    "tailwind-variants": "^3.3.1",
    "valtio-define": "^1.4.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/vite": "4.1.11",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "happy-dom": "^20.11.6",
    "knip": "^6.32.2",
    "tailwindcss": "4.1.11",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
